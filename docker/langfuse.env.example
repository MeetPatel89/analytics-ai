# Copy to docker/langfuse.env and replace every CHANGEME value before starting.
NEXTAUTH_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:CHANGEME@postgres:5432/postgres
SALT=CHANGEME
ENCRYPTION_KEY=CHANGEME_64_HEX_CHARACTERS
NEXTAUTH_SECRET=CHANGEME
CLICKHOUSE_PASSWORD=CHANGEME
MINIO_ROOT_PASSWORD=CHANGEME
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=CHANGEME
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=CHANGEME
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=CHANGEME
REDIS_AUTH=CHANGEME
# Local containers communicate directly; disable the CPU-sensitive Redis watchdog.
REDIS_SOCKET_TIMEOUT_MS=0
POSTGRES_PASSWORD=CHANGEME

# Local headless initialization. Remove these to create the account in the UI.
LANGFUSE_INIT_ORG_ID=analytics-agent
LANGFUSE_INIT_ORG_NAME="Analytics Agent"
LANGFUSE_INIT_PROJECT_ID=analytics-agent
LANGFUSE_INIT_PROJECT_NAME="Analytics Agent"
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-CHANGEME
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-CHANGEME
LANGFUSE_INIT_USER_EMAIL=admin@analytics-agent.local
LANGFUSE_INIT_USER_NAME="Local Admin"
LANGFUSE_INIT_USER_PASSWORD=CHANGEME

# The official self-hosted stack sends anonymous usage telemetry by default.
TELEMETRY_ENABLED=false
